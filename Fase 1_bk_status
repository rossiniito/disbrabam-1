#include "thingProperties.h"
#include <Arduino.h>
#include "OptaBlue.h" // Biblioteca das Expansões
#include <rtos.h>
#include <mbed.h>
#include <drivers/Watchdog.h>

// --- INSTÂNCIAS DAS EXPANSÕES ---
DigitalMechExpansion expDigital; 
AnalogExpansion      expAnalog;

// --- MAPEAMENTO DE ENTRADAS ---
const int IN_REFRIG  = A0; // I1: Pulsador Refrigeração
const int IN_VENT    = A1; // I2: Pulsador Ventilação
const int IN_GAS     = A2; // I3: Pulsador Gás Etil
const int IN_UMIDIF  = A3; // I4: Pulsador Umidificador

// --- MAPEAMENTO DE SAÍDAS (Relés Físicos) ---
const int OUT_REFRIG = D0; // Vai para o R1 (Sitrad)
const int OUT_VENT   = D1; // Vai para o R2 (Ventilação)
const int OUT_GAS    = D2; // Vai para o R3 (Gás Etil)
const int OUT_UMIDIF = D3; // Vai para o R4 (Umidificador)

// --- MAPEAMENTO DE SAÍDAS (LEDs do Painel Frontal) ---
const int LED_REFRIG = LED_D0;
const int LED_VENT   = LED_D1;
const int LED_GAS    = LED_D2;
const int LED_UMIDIF = LED_D3;

// --- CONFIGURAÇÃO DE DEBOUNCE ANTI-RUÍDO ---
const int NUM_ENTRADAS = 4;
const int ENTRADAS[NUM_ENTRADAS] = {IN_REFRIG, IN_VENT, IN_GAS, IN_UMIDIF};

const unsigned long DEBOUNCE_DELAY = 50;
bool estadoEstavel[NUM_ENTRADAS] = {LOW, LOW, LOW, LOW};
bool ultimoLeitura[NUM_ENTRADAS] = {LOW, LOW, LOW, LOW};
unsigned long ultimoTempoDebounce[NUM_ENTRADAS] = {0, 0, 0, 0};

// Estados anteriores das entradas (para detectar borda de pulso)
bool prevEntrada[NUM_ENTRADAS] = {LOW, LOW, LOW, LOW};

// --- ESTADOS LATCH (um pulso liga, outro desliga) ---
// Compartilhados entre botões físicos e virtuais da cloud
bool estadoRefrig = false;
bool estadoVent   = false;
bool estadoGas    = false;
bool estadoUmidif = false;

// --- CONTROLE DE MODO OFFLINE / CONECTIVIDADE ---
bool modoOffline = false;
bool cloudConectado = false;
bool cloudSincronizado = false;

void onCloudConnect();
void onCloudSync();
void onCloudDisconnect();
void verificarStatusConectividade();

// ---------------------------------------------------------
// RECURSO 1: Thread para execução do ArduinoCloud (Offline-First)
// Mantém reconexões em segundo plano sem travar o loop local.
// ---------------------------------------------------------
rtos::Thread cloudThread(osPriorityNormal, 8192);

void cloudThreadFunc() {
  while (true) {
    ArduinoCloud.update();
    rtos::ThisThread::sleep_for(100);
  }
}

void aplicarIntertravamento() {
  // Regra 1: Refrigeração exige ventilação ligada
  if (estadoRefrig) {
    estadoVent = true;
  }
  // Regra 2: Umidificador exige ventilação ligada
  if (estadoUmidif) {
    estadoVent = true;
  }
}

void setup() {
  // Initialize serial and wait for port to open:
  Serial.begin(9600);
  // This delay gives the chance to wait for a Serial Monitor without blocking if none is found
  delay(1500);

  // Defined in thingProperties.h
  initProperties();

  // false = desabilita o watchdog interno da Cloud (usamos thread + watchdog mbed)
  ArduinoCloud.begin(ArduinoIoTPreferredConnection, false);

  ArduinoCloud.addCallback(ArduinoIoTCloudEvent::CONNECT, onCloudConnect);
  ArduinoCloud.addCallback(ArduinoIoTCloudEvent::SYNC, onCloudSync);
  ArduinoCloud.addCallback(ArduinoIoTCloudEvent::DISCONNECT, onCloudDisconnect);

  modoOffline = true;
  cloudConectado = false;
  cloudSincronizado = false;

  setDebugMessageLevel(2);
  ArduinoCloud.printDebugInfo();

  // Inicia a thread que processa a comunicação com a nuvem
  cloudThread.start(cloudThreadFunc);
  delay(100);

  // ---------------------------------------------------------
  // RECURSO 2: Watchdog de Hardware
  // Reinicia o OPTA se o loop travar por mais de 10 segundos.
  // ---------------------------------------------------------
  bool wdg_iniciado = mbed::Watchdog::get_instance().start(10000);
  if (wdg_iniciado) {
    Serial.println("Watchdog ativado com sucesso.");
  }

  // --- INICIALIZAÇÃO DAS EXPANSÕES OPTA ---
  OptaController.begin();
  delay(1000);
  OptaController.update();
  
  expDigital = OptaController.getExpansion(0);
  expAnalog  = OptaController.getExpansion(1);
  
  // Configura o primeiro canal analógico para ler corrente (4-20mA)
  expAnalog.beginChannelAsCurrentAdc(OA_CH_0);

  // Configuração das Entradas
  for (int i = 0; i < NUM_ENTRADAS; i++) {
    pinMode(ENTRADAS[i], INPUT);
  }

  // Configuração dos Relés de Potência
  pinMode(OUT_REFRIG, OUTPUT);
  pinMode(OUT_VENT, OUTPUT);
  pinMode(OUT_GAS, OUTPUT);
  pinMode(OUT_UMIDIF, OUTPUT);

  // Configuração dos LEDs do Painel
  pinMode(LED_REFRIG, OUTPUT);
  pinMode(LED_VENT, OUTPUT);
  pinMode(LED_GAS, OUTPUT);
  pinMode(LED_UMIDIF, OUTPUT);

  // Garantia de Segurança: Força TUDO a iniciar desligado
  digitalWrite(OUT_REFRIG, LOW); digitalWrite(LED_REFRIG, LOW);
  digitalWrite(OUT_VENT, LOW);   digitalWrite(LED_VENT, LOW);
  digitalWrite(OUT_GAS, LOW);    digitalWrite(LED_GAS, LOW);
  digitalWrite(OUT_UMIDIF, LOW); digitalWrite(LED_UMIDIF, LOW);
}

void loop() {
  // Alimenta o watchdog: se o loop travar, reinicia em ~10s
  mbed::Watchdog::get_instance().kick();

  // Verificação periódica do status de conectividade
  static unsigned long ultimaVerificacao = 0;
  if ((millis() - ultimaVerificacao) >= 10000) {
    verificarStatusConectividade();
    ultimaVerificacao = millis();
  }

  unsigned long agora = millis();

  // Atualiza barramento das expansões
  OptaController.update();
  expAnalog.updateAnalogInputs();

  // ========================================================================
  // 1. LEITURA FÍSICA DAS ENTRADAS E DEBOUNCE
  // ========================================================================
  for (int i = 0; i < NUM_ENTRADAS; i++) {
    bool leituraAtual = digitalRead(ENTRADAS[i]);

    if (leituraAtual != ultimoLeitura[i]) {
      ultimoTempoDebounce[i] = agora;
    }

    if ((agora - ultimoTempoDebounce[i]) > DEBOUNCE_DELAY) {
      estadoEstavel[i] = leituraAtual;
    }

    ultimoLeitura[i] = leituraAtual;
  }

  // ========================================================================
  // 2. PULSOS FÍSICOS → TOGGLE DOS ESTADOS LATCH
  //    Borda de subida (pressionar) liga/desliga
  // ========================================================================
  for (int i = 0; i < NUM_ENTRADAS; i++) {
    bool entrada = estadoEstavel[i];

    if (entrada && !prevEntrada[i]) {
      switch (i) {
        case 0: estadoRefrig = !estadoRefrig; break;
        case 1: estadoVent   = !estadoVent;   break;
        case 2: estadoGas    = !estadoGas;    break;
        case 3: estadoUmidif = !estadoUmidif; break;
      }
    }

    prevEntrada[i] = entrada;
  }

  // ========================================================================
  // 3. LÓGICA DE INTERTRAVAMENTO INDUSTRIAL
  // ========================================================================
  aplicarIntertravamento();

  // ========================================================================
  // 4. ATUALIZAÇÃO DA NUVEM (RATE LIMITING - 1 ATUALIZAÇÃO POR SEGUNDO)
  // Isso impede que as flutuações do sensor analógico travem o App
  // ========================================================================
  static unsigned long ultimoTempoCloud = 0;
  if (agora - ultimoTempoCloud >= 1000) { 
    ultimoTempoCloud = agora;

    // Calcula e envia a leitura do sensor
    float corrente_mA = expAnalog.pinCurrent(OA_CH_0);
    float ppm_calculado = 0.0;
    
    if (corrente_mA >= 4.0) {
      ppm_calculado = (corrente_mA - 4.0) * 12.5; 
      if (ppm_calculado > 200.0) ppm_calculado = 200.0;
    }
    leitura_Etil = ppm_calculado;

    // Envia o status dos relés (se as variáveis existirem no seu thingProperties)
    status_Refrig = estadoRefrig;
    status_Vent   = estadoVent;
    status_Gas    = estadoGas;
    status_Umidif = estadoUmidif;
  }

  // ========================================================================
  // 5. ACIONAMENTO DE POTÊNCIA E LEDs
  // ========================================================================
  digitalWrite(OUT_REFRIG, estadoRefrig ? HIGH : LOW);
  digitalWrite(OUT_VENT,   estadoVent   ? HIGH : LOW);
  digitalWrite(OUT_GAS,    estadoGas    ? HIGH : LOW);
  digitalWrite(OUT_UMIDIF, estadoUmidif ? HIGH : LOW);

  digitalWrite(LED_REFRIG, estadoRefrig ? HIGH : LOW);
  digitalWrite(LED_VENT,   estadoVent   ? HIGH : LOW);
  digitalWrite(LED_GAS,    estadoGas    ? HIGH : LOW);
  digitalWrite(LED_UMIDIF, estadoUmidif ? HIGH : LOW);
}

// --- Conectividade / callbacks da Cloud ---

void verificarStatusConectividade() {
  bool agoraConectado = ArduinoCloud.connected();

  if (agoraConectado && cloudConectado == false) {
    onCloudConnect();
  } else if (agoraConectado == false && cloudConectado) {
    onCloudDisconnect();
  }
}

void onCloudConnect() {
  cloudConectado = true;
  modoOffline = false;
  cloudSincronizado = false;
}

void onCloudSync() {
  cloudSincronizado = true;
}

void onCloudDisconnect() {
  cloudConectado = false;
  cloudSincronizado = false;
  modoOffline = true;
}

